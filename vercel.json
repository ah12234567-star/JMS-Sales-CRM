{
  "rewrites": [
    { "source": "/vendor/xlsx.min.js", "destination": "https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js" },
    { "source": "/vendor/html2pdf.bundle.min.js", "destination": "https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js" },
    { "source": "/quote", "destination": "/quote.html" },
    { "source": "/api/auth-update-user", "destination": "/api/auth-create-user?action=update" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
